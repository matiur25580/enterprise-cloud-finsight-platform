# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://finsight:finsight_dev@localhost:5432/finsight?schema=public"

# Auth.js (generate with: npx auth secret)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Public application origin used to build verification links
APP_URL=http://localhost:3000

# Required for email verification and password reset (Resend)
RESEND_API_KEY=
EMAIL_FROM=FinSight <onboarding@your-verified-domain.example>

# Optional: isolated background worker only; provision a dedicated non-superuser BYPASSRLS role.
# Never set this on the public web service.
SYNC_WORKER_DATABASE_URL=
# Built-in HashiCorp Vault KV v2 backend (worker only).
SECRET_MANAGER_BACKEND=vault
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=
VAULT_NAMESPACE=
# Optional custom resolver; used when SECRET_MANAGER_BACKEND is not 'vault'.
SECRET_RESOLVER_URL=
SECRET_RESOLVER_TOKEN=

# AI provider (optional; never commit real credentials)
OPENAI_API_KEY=

# Optional cloud sync notifications (background worker only)
# Slack incoming webhook; only hooks.slack.com / hooks.slack-gov.com HTTPS URLs are accepted.
SLACK_SYNC_ALERT_WEBHOOK_URL=
SYNC_ALERT_EMAIL_FROM=
SYNC_ALERT_EMAIL_TO=
