generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  FINOPS_ANALYST
  VIEWER
  @@map("membership_role")
}
enum CloudProvider {
  AWS
  AZURE
  GCP
  @@map("cloud_provider")
}
enum CloudAccountStatus {
  ACTIVE
  PAUSED
  ERROR
  @@map("cloud_account_status")
}
enum CloudSyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
  @@map("cloud_sync_job_status")
}
enum CloudSyncTrigger {
  MANUAL
  SCHEDULED
  @@map("cloud_sync_trigger")
}
enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
  @@map("budget_period")
}
enum RecommendationStatus {
  NEW
  ACCEPTED
  DISMISSED
  IMPLEMENTED
  @@map("recommendation_status")
}

model Organization {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships     Membership[]
  cloudAccounts   CloudAccount[]
  costRecords     CostRecord[]
  budgets         Budget[]
  auditLogs       AuditLog[]
  recommendations Recommendation[]
  recommendationImpacts RecommendationImpact[]
  sharedCostAllocationRules SharedCostAllocationRule[]
  sharedCostAllocationRuns SharedCostAllocationRun[]
  importBatches    ImportBatch[]
  cloudSyncJobs    CloudSyncJob[]
  invitations      OrganizationInvitation[]
  businessMetrics  BusinessMetric[]
  revenueRecords   RevenueRecord[]
  tagPolicies      TagPolicy[]
  @@map("organizations")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  passwordHash  String?      @map("password_hash")
  emailVerified DateTime?    @map("email_verified") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships   Membership[]
  auditLogs     AuditLog[]
  uploadedImports ImportBatch[]
  sentInvitations OrganizationInvitation[] @relation("InvitationSender")
  @@map("users")
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  userId         String         @map("user_id")
  role           MembershipRole @default(VIEWER)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("memberships")
}

model CloudAccount {
  id                String             @id @default(cuid())
  organizationId    String             @map("organization_id")
  provider          CloudProvider
  externalAccountId String             @map("external_account_id")
  name              String
  status            CloudAccountStatus @default(ACTIVE)
  currency          String             @default("USD") @db.VarChar(3)
  lastSyncedAt      DateTime?          @map("last_synced_at") @db.Timestamptz(6)
  lastSyncAttemptAt DateTime?          @map("last_sync_attempt_at") @db.Timestamptz(6)
  credentialRef     String?            @map("credential_ref") @db.VarChar(500)
  syncEnabled       Boolean            @default(false) @map("sync_enabled")
  syncIntervalMinutes Int              @default(1440) @map("sync_interval_minutes")
  nextSyncAt        DateTime?          @map("next_sync_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costRecords       CostRecord[]
  importBatches     ImportBatch[]
  syncJobs          CloudSyncJob[]
  @@unique([organizationId, id])
  @@unique([organizationId, provider, externalAccountId])
  @@index([organizationId, provider, status])
  @@map("cloud_accounts")
}

model CostRecord {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  cloudAccountId String       @map("cloud_account_id")
  externalId     String?      @map("external_id")
  service        String
  region         String?
  usageType      String?      @map("usage_type")
  resourceId     String?      @map("resource_id")
  amount         Decimal      @db.Decimal(20, 8)
  currency       String       @db.VarChar(3)
  usageDate      DateTime     @map("usage_date") @db.Date
  tags           Json         @default("{}")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  fingerprint     String
  importBatchId   String?       @map("import_batch_id")
  sourceRowNumber Int?          @map("source_row_number")
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cloudAccount    CloudAccount  @relation(fields: [organizationId, cloudAccountId], references: [organizationId, id], onDelete: Cascade)
  importBatch     ImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  @@unique([cloudAccountId, externalId])
  @@unique([cloudAccountId, fingerprint])
  @@index([importBatchId])
  @@index([organizationId, usageDate])
  @@index([organizationId, service, usageDate])
  @@index([cloudAccountId, usageDate])
  @@map("cost_records")
}

model Budget {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  name            String
  amount          Decimal      @db.Decimal(20, 8)
  currency        String       @default("USD") @db.VarChar(3)
  period          BudgetPeriod @default(MONTHLY)
  startsAt        DateTime     @map("starts_at") @db.Date
  endsAt          DateTime     @map("ends_at") @db.Date
  alertThresholds Int[]        @default([50, 80, 100]) @map("alert_thresholds")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, isActive, startsAt, endsAt])
  @@map("budgets")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  actorUserId    String?      @map("actor_user_id")
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id")
  metadata       Json?
  ipAddress      String?      @map("ip_address")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}


enum ImportStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  @@map("import_status")
}

model ImportBatch {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  cloudAccountId   String       @map("cloud_account_id")
  uploadedByUserId String?      @map("uploaded_by_user_id")
  fileName         String       @map("file_name") @db.VarChar(255)
  status           ImportStatus @default(PROCESSING)
  totalRows        Int          @default(0) @map("total_rows")
  importedRows     Int          @default(0) @map("imported_rows")
  rejectedRows     Int          @default(0) @map("rejected_rows")
  duplicateRows    Int          @default(0) @map("duplicate_rows")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(6)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cloudAccount     CloudAccount @relation(fields: [organizationId, cloudAccountId], references: [organizationId, id], onDelete: Cascade)
  uploadedBy       User?        @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  costRecords      CostRecord[]
  issues           ImportIssue[]
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@map("import_batches")
}

model ImportIssue {
  id            String      @id @default(cuid())
  importBatchId String      @map("import_batch_id")
  rowNumber     Int         @map("row_number")
  errorCode     String      @map("error_code") @db.VarChar(80)
  message       String      @db.VarChar(1000)
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  @@unique([importBatchId, rowNumber])
  @@map("import_issues")
}

model Recommendation {
  id                      String               @id @default(cuid())
  organizationId          String               @map("organization_id")
  title                   String
  description             String
  provider                CloudProvider?
  estimatedMonthlySavings Decimal              @map("estimated_monthly_savings") @db.Decimal(20, 8)
  currency                String               @default("USD") @db.VarChar(3)
  confidence              Int
  status                  RecommendationStatus @default(NEW)
  evidence                Json
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  impacts                 RecommendationImpact[]
  @@index([organizationId, status, createdAt])
  @@unique([organizationId, id])
  @@map("recommendations")
}

model RecommendationImpact {
  id                    String         @id @default(cuid())
  organizationId        String         @map("organization_id")
  recommendationId      String         @map("recommendation_id")
  currency              String         @db.VarChar(3)
  scope                 String         @db.VarChar(160)
  baselineStartsAt      DateTime       @map("baseline_starts_at") @db.Date
  baselineEndsAt        DateTime       @map("baseline_ends_at") @db.Date
  observedStartsAt      DateTime       @map("observed_starts_at") @db.Date
  observedEndsAt        DateTime       @map("observed_ends_at") @db.Date
  periodDays            Int            @map("period_days")
  baselineSpend         Decimal        @map("baseline_spend") @db.Decimal(20, 8)
  observedSpend         Decimal        @map("observed_spend") @db.Decimal(20, 8)
  realizedSavings       Decimal        @map("realized_savings") @db.Decimal(20, 8)
  baselineRecords       Int            @map("baseline_records")
  observedRecords       Int            @map("observed_records")
  recordedByUserId      String         @map("recorded_by_user_id")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendation        Recommendation @relation(fields: [organizationId, recommendationId], references: [organizationId, id], onDelete: Cascade)
  @@unique([recommendationId, baselineStartsAt, baselineEndsAt, observedStartsAt, observedEndsAt], map: "recommendation_impacts_period_key")
  @@index([organizationId, recommendationId, createdAt(sort: Desc)], map: "recommendation_impacts_org_recommendation_created_idx")
  @@map("recommendation_impacts")
}


model CloudSyncJob {
  id               String             @id @default(cuid())
  organizationId   String             @map("organization_id")
  cloudAccountId   String             @map("cloud_account_id")
  status           CloudSyncJobStatus @default(QUEUED)
  trigger          CloudSyncTrigger   @default(MANUAL)
  attemptCount     Int                @default(0) @map("attempt_count")
  maxAttempts      Int                @default(3) @map("max_attempts")
  availableAt      DateTime           @default(now()) @map("available_at") @db.Timestamptz(6)
  startedAt        DateTime?          @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?          @map("completed_at") @db.Timestamptz(6)
  errorCode        String?            @map("error_code") @db.VarChar(100)
  errorMessage     String?            @map("error_message") @db.VarChar(1000)
  totalRows        Int                @default(0) @map("total_rows")
  importedRows     Int                @default(0) @map("imported_rows")
  rejectedRows     Int                @default(0) @map("rejected_rows")
  duplicateRows    Int                @default(0) @map("duplicate_rows")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cloudAccount     CloudAccount       @relation(fields: [organizationId, cloudAccountId], references: [organizationId, id], onDelete: Cascade)
  @@index([status, availableAt, createdAt])
  @@index([organizationId, cloudAccountId, createdAt(sort: Desc)])
  @@map("cloud_sync_jobs")
}


model OrganizationInvitation {
  id                String         @id @default(cuid())
  organizationId    String         @map("organization_id")
  email             String         @db.VarChar(254)
  role              MembershipRole @default(VIEWER)
  tokenHash         String         @unique @map("token_hash") @db.VarChar(64)
  invitedByUserId   String         @map("invited_by_user_id")
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(6)
  acceptedAt        DateTime?      @map("accepted_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy         User           @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([email, expiresAt])
  @@map("organization_invitations")
}

enum SharedCostAllocationMethod {
  EQUAL
  WEIGHTED
  @@map("shared_cost_allocation_method")
}

model SharedCostAllocationRule {
  id              String                     @id @default(cuid())
  organizationId  String                     @map("organization_id")
  name            String                     @db.VarChar(100)
  servicePattern  String                     @map("service_pattern") @db.VarChar(160)
  sourceTagKey    String                     @map("source_tag_key") @db.VarChar(120)
  sourceTagValue  String                     @map("source_tag_value") @db.VarChar(160)
  targetDimension String                     @map("target_dimension") @db.VarChar(32)
  method          SharedCostAllocationMethod @default(EQUAL)
  recipients      Json
  isActive        Boolean                    @default(true) @map("is_active")
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs            SharedCostAllocationRun[]
  @@index([organizationId, isActive, createdAt])
  @@map("shared_cost_allocation_rules")
}

model SharedCostAllocationRun {
  id              String                   @id @default(cuid())
  organizationId  String                   @map("organization_id")
  ruleId          String                   @map("rule_id")
  startsAt        DateTime                 @map("starts_at") @db.Date
  endsAt          DateTime                 @map("ends_at") @db.Date
  matchedRecords  Int                      @default(0) @map("matched_records")
  sourceTotals    Json                     @map("source_totals")
  allocations     Json
  createdByUserId String                   @map("created_by_user_id")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule            SharedCostAllocationRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, ruleId, createdAt(sort: Desc)])
  @@map("shared_cost_allocation_runs")
}


model BusinessMetric {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  metricName     String       @map("metric_name") @db.VarChar(100)
  unit           String       @db.VarChar(40)
  value          Decimal      @db.Decimal(20, 4)
  metricDate     DateTime     @map("metric_date") @db.Date
  source         String       @default("MANUAL") @db.VarChar(40)
  notes          String?      @db.VarChar(500)
  createdByUserId String      @map("created_by_user_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, metricDate])
  @@index([organizationId, metricName, metricDate])
  @@map("business_metrics")
}


model RevenueRecord {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  amount          Decimal      @db.Decimal(20, 8)
  currency        String       @db.VarChar(3)
  revenueDate     DateTime     @map("revenue_date") @db.Date
  source          String       @default("MANUAL") @db.VarChar(40)
  notes           String?      @db.VarChar(500)
  createdByUserId String       @map("created_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, revenueDate])
  @@index([organizationId, currency, revenueDate])
  @@map("revenue_records")
}


model TagPolicy {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  tagKey         String       @map("tag_key") @db.VarChar(120)
  displayName    String       @map("display_name") @db.VarChar(100)
  isRequired     Boolean      @default(true) @map("is_required")
  allowedValues  String[]     @default([]) @map("allowed_values")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, tagKey])
  @@index([organizationId, isActive, createdAt])
  @@map("tag_policies")
}
